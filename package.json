{
  "name": "purescript-node-os",
  "private": true,
  "scripts": {
    "build": "spago-legacy build",
    "test": "spago-legacy test",
    "lint": "oxlint --deny-warnings src",
    "format": "purs-tidy format-in-place src test && oxfmt --write \"src/**/*.js\"",
    "format:check": "purs-tidy check src test && oxfmt --check \"src/**/*.js\""
  },
  "devDependencies": {
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "purescript": "0.15.16",
    "purs-tidy": "0.11.1",
    "spago-legacy": "0.21.0"
  }
}
